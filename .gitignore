node_modules/
dist/
build/
out/
.tmp/
*.tsbuildinfo

# Local build tooling: CMake/Ninja virtualenv, vcpkg checkout, and the C++
# dependencies it builds. All reproducible from scripts/setup-windows.bat.
.tooling/
vcpkg_installed/

# The engine binary is published here by scripts/build-native.bat.
apps/desktop/resources/engine/

# Test fixtures are written by tests/fixtures/generate.mjs.
tests/fixtures/*.png
tests/fixtures/*.dng
tests/fixtures/*.heic

# Spike build artefacts. The source and the findings are kept; the binaries,
# the runtime DLLs and the model files are not.
spikes/**/*.exe
spikes/**/*.obj
spikes/**/*.dll

.vscode/
.DS_Store
